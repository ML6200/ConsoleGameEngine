<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="NLog" Version="6.0.7" />
      <PackageReference Include="SoundFlow" Version="1.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="assets\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="nlog.xml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- dotnet build -c Performance-->
    <PropertyGroup Condition="'$(Configuration)' == 'Performance'">
        <DefineConstants>$(DefineConstants);PERFORMANCE_MODE</DefineConstants>
        <Optimize>true</Optimize>
    </PropertyGroup>

</Project>
