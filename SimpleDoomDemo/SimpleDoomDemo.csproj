<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="NLog" Version="6.0.7" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ConsoleGameEngine\ConsoleGameEngine.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="nlog.xml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <Target Name="CopyDebugFolder" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Debug'">
        <ItemGroup>
            <!-- Replace "MyFolder" with your actual directory name -->
            <SourceFiles Include="assets\**\*.*" />
        </ItemGroup>

        <Copy SourceFiles="@(SourceFiles)"
              DestinationFiles="@(SourceFiles->'$(TargetDir)MyFolder\%(RecursiveDir)%(Filename)%(Extension)')"
        />
    </Target>

</Project>
